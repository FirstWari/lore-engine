# Lore Engine - Environment Configuration (optional)
# No LLM or API keys required: `python lore.py <input>` runs 100% locally.

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Directory where downloaded videos/subtitles land (results go to --out, default results/)
# LORE_WORKSPACE_DIR=downloads

# Optional Coursera cookies file path for lecture downloading
# COURSERA_COOKIE_FILE=www.coursera.org_cookies.txt

