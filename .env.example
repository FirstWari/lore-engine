# Lore Engine MCP Server - Environment Configuration
# No LLM or Gemini API keys required! Lore Engine runs 100% locally as an MCP server.

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Default workspace directory for downloads and processed results (relative or absolute)
# LORE_WORKSPACE_DIR=downloads

# Optional Coursera cookies file path for lecture downloading
# COURSERA_COOKIE_FILE=www.coursera.org_cookies.txt

